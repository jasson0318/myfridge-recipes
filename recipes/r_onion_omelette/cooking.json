{
  "recipeId": "r_onion_omelette",
  "version": 2,
  "steps": [
    {
      "step": 1,
      "text": "洋蔥切絲；雞蛋加鹽打勻。",
      "title": "備料",
      "minutes": 3
    },
    {
      "step": 2,
      "text": "平底鍋中火熱油，下洋蔥炒 2 分鐘至透明。",
      "title": "炒洋蔥",
      "minutes": 2,
      "heatLevel": "中火",
      "tool": "pan"
    },
    {
      "step": 3,
      "text": "倒入蛋液，轉中小火。",
      "title": "倒蛋",
      "heatLevel": "中小火",
      "tool": "pan"
    },
    {
      "step": 4,
      "text": "待邊緣凝固後輕晃鍋，蓋鍋煎 2 分鐘。",
      "title": "煎定",
      "minutes": 2,
      "heatLevel": "中小火",
      "tool": "pan"
    },
    {
      "step": 5,
      "text": "對折或整片滑出盤中。",
      "title": "完成"
    }
  ]
}
