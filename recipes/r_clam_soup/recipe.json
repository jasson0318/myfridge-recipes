  "steps": [
    {
      "step": 1,
      "text": "蛤蜊泡鹽水吐沙 30 分鐘（或購已處理），沖洗。",
      "title": "吐沙",
      "minutes": 30
    },
    {
      "step": 2,
      "text": "薑切絲；蔥切花；鍋加 800 ml 水與薑，大火煮滾。",
      "title": "起湯",
      "minutes": 5,
      "heatLevel": "大火",
      "tool": "pot"
    },
    {
      "step": 3,
      "text": "下蛤蜊，大火煮至大部分開殼，約 3 分鐘。",
      "title": "煮蛤蜊",
      "minutes": 3,
      "heatLevel": "大火",
      "tool": "pot"
    },
    {
      "step": 4,
      "text": "未開殼者Discard，撒蔥花，依喜好加少許鹽。",
      "title": "完成",
      "minutes": 1
    }
  ],
  "published": true
